{
  "manifest_version": 3,
  "name": "SoundBuffer",
  "version": "0.1.0",
  "description": "Capture the current tab's audio on demand.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SoundBuffer",
    "default_popup": "index.html"
  }
}
